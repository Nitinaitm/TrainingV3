<%@ Page Title="Session Certificate Report" Language="C#" MasterPageFile="~/ManagerMaster.Master" AutoEventWireup="true" CodeBehind="SessionCertificateReport.aspx.cs" Inherits="Training.Manager.SessionCertificateReport" %>
<asp:Content ID="Content1" ContentPlaceHolderID="head" runat="server"><style>.cr-card{background:#fff;border-radius:12px;box-shadow:0 2px 10px rgba(0,0,0,.08);margin:20px 0}.cr-title{font-size:24px;font-weight:700;color:#0d6efd}.cr-table th{background:#0d6efd;color:#fff;text-align:center;white-space:nowrap}</style></asp:Content>
<asp:Content ID="Content2" ContentPlaceHolderID="ContentPlaceHolder1" runat="server"><div class="container-fluid"><div class="cr-card p-3"><div class="cr-title">Session Certificate Report</div><asp:Label ID="lblSession" runat="server" CssClass="text-muted" /><div class="table-responsive mt-3"><asp:GridView ID="gvCertificate" runat="server" AutoGenerateColumns="false" CssClass="table table-bordered table-hover cr-table"><Columns><asp:TemplateField HeaderText="#"><ItemTemplate><%# Container.DataItemIndex+1 %></ItemTemplate></asp:TemplateField><asp:BoundField DataField="EmpID" HeaderText="Trainee ID" /><asp:BoundField DataField="EmpName" HeaderText="Trainee Name" /><asp:BoundField DataField="CertificateNo" HeaderText="Certificate No" /><asp:BoundField DataField="VerificationCode" HeaderText="Verification Code" /><asp:BoundField DataField="PDFName" HeaderText="Certificate File" /><asp:BoundField DataField="GeneratedOn" HeaderText="Generated On" DataFormatString="{0:dd-MM-yyyy hh:mm tt}" /></Columns><EmptyDataTemplate><div class="text-center p-3 text-muted">No certificate generated for this training/session.</div></EmptyDataTemplate></asp:GridView></div><asp:Button ID="btnBack" runat="server" Text="Back" CssClass="btn btn-secondary" OnClick="btnBack_Click" /></div></div></asp:Content>