<%@ Page Title="Session Attendance Report" Language="C#" MasterPageFile="~/TrainerMaster.Master" AutoEventWireup="true" CodeBehind="SessionAttendanceReport.aspx.cs" Inherits="Training.Trainer.SessionAttendanceReport" %>
<asp:Content ID="Content1" ContentPlaceHolderID="head" runat="server"><style>.ar-card{background:#fff;border-radius:12px;box-shadow:0 2px 10px rgba(0,0,0,.08);margin:20px 0}.ar-title{font-size:24px;font-weight:700;color:#0d6efd}.ar-table th{background:#0d6efd;color:#fff;text-align:center;white-space:nowrap}</style></asp:Content>
<asp:Content ID="Content2" ContentPlaceHolderID="ContentPlaceHolder1" runat="server"><div class="container-fluid"><div class="ar-card p-3"><div class="ar-title">Session Attendance Report</div><div class="text-muted mb-3"><asp:Label ID="lblSession" runat="server" /></div><div class="row mb-3"><div class="col-md-3"><b>Total</b><div><asp:Label ID="lblTotal" runat="server" /></div></div><div class="col-md-3"><b>Present</b><div><asp:Label ID="lblPresent" runat="server" /></div></div><div class="col-md-3"><b>Absent</b><div><asp:Label ID="lblAbsent" runat="server" /></div></div><div class="col-md-3"><b>Pending</b><div><asp:Label ID="lblPending" runat="server" /></div></div></div><div class="table-responsive"><asp:GridView ID="gvAttendance" runat="server" AutoGenerateColumns="false" CssClass="table table-bordered table-hover ar-table"><Columns><asp:TemplateField HeaderText="#"><ItemTemplate><%# Container.DataItemIndex+1 %></ItemTemplate></asp:TemplateField><asp:BoundField DataField="EmpID" HeaderText="Employee ID" /><asp:BoundField DataField="EmpName" HeaderText="Employee Name" /><asp:BoundField DataField="EmpDesignation" HeaderText="Designation" /><asp:BoundField DataField="AttendanceStatus" HeaderText="Attendance" /><asp:BoundField DataField="Remarks" HeaderText="Remarks" /></Columns><EmptyDataTemplate><div class="text-center p-3 text-muted">No attendance data found.</div></EmptyDataTemplate></asp:GridView></div><asp:Button ID="btnBack" runat="server" Text="Back" CssClass="btn btn-secondary" OnClick="btnBack_Click" /></div></div></asp:Content>